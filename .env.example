# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
# Use the cheapest current "mini" model listed at https://platform.openai.com/docs/models
OPENAI_MODEL=gpt-4o-mini
# Model for the LLM-as-judge in evals/run_v2_eval.py. A stronger model than the agent's
# grades more reliably (gpt-4o-mini invented evidence in the M6 eval). Defaults to OPENAI_MODEL.
JUDGE_MODEL=gpt-4o
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_ENABLE_AUTH=false
