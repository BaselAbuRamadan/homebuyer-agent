# Copy to .env and fill in. Never commit .env.
# On Streamlit Cloud, put the same keys in the app's Secrets box instead.
OPENAI_API_KEY=sk-...

# Everyday model: router, planner and most answers. Use a cheap "mini" model.
OPENAI_MODEL=gpt-4o-mini

# Stronger model the agent switches to WHEN NEEDED: multi-step questions (3+ tool steps),
# or a retry when a cheap attempt fails a check (empty answer, failed tool, too-short
# explanation). If it's unavailable, the agent falls back to OPENAI_MODEL.
# Leave it out to run everything on OPENAI_MODEL.
SMART_MODEL=gpt-4o

# Web app only: questions per day from ALL visitors together (default 300).
# DAILY_QUESTION_LIMIT=300

# Model for the LLM-as-judge in evals/run_v2_eval.py. A stronger model than the agent's
# grades more reliably (gpt-4o-mini invented evidence in the M6 eval). Defaults to OPENAI_MODEL.
JUDGE_MODEL=gpt-4o

# Local tracing (evals and scripts with --trace). Not used by the web app.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_ENABLE_AUTH=false
